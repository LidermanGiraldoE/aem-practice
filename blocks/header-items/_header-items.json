{
  "definitions": [
    {
      "title": "Header Items",
      "id": "header-items",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Header Items",
              "filter": "header-items"
            }
          }
        }
      }
    },
    {
      "title": "Header Item",
      "id": "header-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Header Item",
              "model": "header-item",
              "level": "1"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "header-item",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "name",
          "label": "Header Item Name",
          "description": "The name displayed in the Content Tree"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "content_label",
          "label": "Label",
          "required": true
        },
        {
          "component": "aem-content",
          "name": "content_link",
          "label": "Link",
          "description": "Optional for items that only open a submenu"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "description",
          "label": "Description",
          "description": "Optional short text shown under the item inside the submenu"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "level",
          "label": "Level",
          "value": "1",
          "description": "Items nest under the closest previous item with a lower level",
          "options": [
            { "name": "1 - Main menu", "value": "1" },
            { "name": "2 - Submenu", "value": "2" },
            { "name": "3 - Submenu of a submenu", "value": "3" },
            { "name": "4 - Fourth level", "value": "4" }
          ]
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "header-items",
      "components": [
        "header-item"
      ]
    }
  ]
}